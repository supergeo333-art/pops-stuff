                           00008A    57 	IT1 .equ 0x88+2           ; Outer interruption 1 signal mode control level, 1: falling edge interruption, 0: rising and falling are all interrupted.
                           000089    58 	IE0 .equ 0x88+1           ; The 0 marker is interrupted outside
                           000088    59 	IT0 .equ 0x88+0           ; The outer interruption of the 0 signal mode control level, 1: the falling edge is interrupted, and 0: the rising and falling are all interrupted.
