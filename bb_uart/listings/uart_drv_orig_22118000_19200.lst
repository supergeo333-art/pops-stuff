                           0000FC   659 CCAP2H .equ 0xFC              ; PCA Module 2 Capture/Compare Register High Byte
                                    660 
                                    661 ; 0xFD	not used
                                    662 ; 0xFE	not used
                                    663 ; 0xFF	not used
                                    664 
                                    665 
                                    666 
                                     12 
                                     13 ;-----------------------------------------------------------------------
                                     14 ; Software UART
                                     15 ;-----------------------------------------------------------------------
                           1517E70    16 MPU_CLK_HZ	.EQU		22118000			; 22.118MHz, 30.041 MHz Max
                           000001    17 CLKDV		.EQU		1					; system clock No divide
                           00000C    18 CLKDV12		.EQU		12					; system clock divide 12
                                     19 
                           0000B0    20 SW_RX		.EQU		P3.0				; MCU_RxD(P3.0), SW UART RX GPIO pin (must be /INT4)
                           0000B1    21 SW_TX		.EQU		P3.1				; MCU_TxD(P3.1), SW UART TX GPIO pin (can be any GPIO pin)
                                     22 ;
                           004B00    23 BAUD		.EQU		19200			; baud rate, 1152	;19200bps @ 22.1184MHz 1146 tick
                           00047F    24 BAUD_RATE	.EQU		((MPU_CLK_HZ/CLKDV)/BAUD)	; (FOSC/CLKDV/BAUD), SYSCLK_FREQ/DIV/BAUD_RATE
                                     25 ;
                           000000    26 TX_CORR		.EQU		0				; Timer preload correction value in cycles for TX, should only offset the start bit
                           000000    27 RX_CORR		.EQU		0				; Timer preload correction value in cycles for RX, should only offset the start bit
                           000033    28 THALF_CORR	.EQU		51				; Timer preload correction value for 3/2 RX, machine cycles
                                     29 										; Start-Bit is asynchronously generated by INT4. INT4 to mid-bit is firmware
                                     30 ;
                                     31 ; Timer0 is the Recive Clock, started on /INT4 runs asynchronously
                                     32 ; Timer2 is the Transmit Clock, runs synchronously
                           00FB81    33 TXBAUD		.EQU		(65536-(BAUD_RATE-TX_CORR))	; actual 16-bit bit counter cycle value  TX
                           00FB81    34 RXBAUD		.EQU		(65536-(BAUD_RATE-RX_CORR))	; actual 16-bit bit counter cycle value  RX
                           00F975    35 RXBAUD_HLF	.EQU		(65536-(BAUD_RATE+(BAUD_RATE/2)-THALF_CORR))	; 1.5 bit time + adjusted for process delay
                                     36 ;
                                     37 ; SWSCON: Software Serial Port Control (Bit-Addressable) Register
                           000020    38 SWSCON		.EQU		0x20				; Serial Port Control Register
                                     39 ; Bits
                           000000    40 SWRI		.EQU		0x00			; Receive interrupt flag, set on 8th RX BIT in, cleared by software.
                           000001    41 SWTI		.EQU		0x01			; Transmit interrupt flag, set on 8th TX BIT out, cleared by software.
                           000002    42 SWBRK		.EQU		0x02			; RX break signal
                           000003    43 SWBFF		.EQU		0x03			; RX buffer overflow
                           000004    44 SWREN		.EQU		0x04			; (0) Enables serial reception.
                           000005    45 SRXBSY		.EQU		0x05			; Receiver Busy. "SWSM0"
                           000006    46 STXBSY		.EQU		0x06			; Transmitter Busy. "SWSM1"
                           000007    47 SWFE		.EQU		0x07			; Framing Error BIT, should be cleared by software. SM2 on write
                                     48 ;
                                     49 ; UART BYTE BUFFER
                           000030    50 RXBIN		.EQU		0x30			; RX BIT accumulator
                           000031    51 RXDATA		.EQU		0x31			; RX Data Buffer
                           000032    52 TXBIN		.EQU		0x32			; TX BIT decimator
                           000033    53 TXDATA		.EQU		0x33			; TX Data Buffer
                                     54 ;
                                     55 ; UART STATE MACINE
                           000034    56 SURXST		.EQU		0x34			; receiver state, BIT count
                           000035    57 SUTXST		.EQU		0x35			; transmitter state, BIT count
                                     58 ;
                                     59 ; UART RX RING BUFFER
                           000040    60 RXBUFFER	.EQU		0x40			; 0x40 - 0x4F Receive Buffer
                           00004F    61 RXBUFEND	.EQU		(RXBUFFER+0x0F)	; buffer end 16(0x0F)/32(0x1F) bytes
                                     62 ;
                                     63 
                                     64 ;=======================================================
                                     65 ; Interrupt Vectors Table (ABS addresses 0x0000-0x002B)
                                     66 ;=======================================================
                                     67 .area VECTOR    (CODE)
                                     68 .area INTV (ABS)				; allow .org defines
                                     69 
                                     70 		;; --- Rest Vector  ---
      000000                         71 		.ORG    0x0000
      000000 02r01r00         [24]   72 		LJMP    _START
                                     73 
                                     74 		;; --- Externa 0 Interrupt (INT0) ---
                                     75 		.area INT0 (ABS,CODE)
      000003                         76 		.ORG    0x0003
      000003 32               [24]   77 		RETI
                                     78 
                                     79 		;; --- Timer 0 Interrupt (TF0) ---
                                     80 		.area TMR0 (ABS,CODE)
      00000B                         81 		.ORG    0x000B
      00000B 02r01r8B         [24]   82 		LJMP	_TIMER0_ISR
                                     83 
                                     84 		;; --- Externa 1 Interrupt (INT1) ---
                                     85 		.area INT1 (ABS,CODE)
      000013                         86 		.ORG    0x0013
                                     87 		;LJMP	_EXT1_ISR
      000013 32               [24]   88 		RETI
                                     89 
                                     90 		;; --- Externa 2 Interrupt (INT2) ---
                                     91 		.area INT2 (ABS,CODE)
      000053                         92 		.ORG    0x0053
      000053 32               [24]   93 		RETI
                                     94 
                                     95 		;; --- Externa 3 Interrupt (INT3) ---
                                     96 		.area INT3 (ABS,CODE)
      00005B                         97 		.ORG    0x005B
                                     98 		;LJMP	_EXT3_ISR
      00005B 32               [24]   99 		RETI
                                    100 
                                    101 		;; --- Timer 2 Interrupt (TF0) ---
                                    102 		.area TMR2 (ABS,CODE)
      000063                        103 		.ORG    0x0063      ; Timer 2
      000063 02r02r3F         [24]  104 		LJMP   _TIMER2_ISR
                                    105 
                                    106 		;; --- Externa 4 Interrupt (INT4) ---
                                    107 		.area INT4 (ABS,CODE)
      000083                        108 		.ORG    0x0083
      000083 02r01r85         [24]  109 		LJMP   _INT4_ISR
                                    110 
                                    111 
                                    112 ; ============================================================
                                    113 ;				MAIN PROGRAM CODE
                                    114 ; ============================================================
                                    115 .AREA CSEG (ABS,CODE) ; ABSOLUTE ADDRESS, debugging
      000100                        116 .ORG 0X0100
                                    117 
      000100                        118 _START:
                                    119 
                                    120 			; INITIALIZE STACK POINTER
      000100 75 81 60         [24]  121 			MOV SP, 	#0x60           ; set stack pointer STACK TEST, 32 byte stack
      000103 53 D0 E7         [24]  122 			ANL	PSW,	#(~0x18)		; Bank zero(0)
                                    123 
      000106r01r13            [24]  124 			ACALL	UART_INIT			; bit-bang uart configuration
                                    125 
      000108                        126 _START00:	
                                    127 
      000108r01r66            [24]  128 			ACALL	RX_BLIND			; call is blocking
                                    129 			
                                    130 			
                                    131 			; echo back data
      00010A 85 31 33         [24]  132 			MOV	TXDATA,RXDATA				
      00010Dr02r18            [24]  133 			ACALL	TX_TRANSMIT
      00010F 40 FC            [24]  134 			JC	(.-2)						; wait for completion, STXBSY clear
                                    135 
                                    136 
      000111 80 F5            [24]  137 			SJMP	_START00
                                    138 
                                    139 
                                    140 
                                    141 ;=======================================================================
                                    142 ;				UART BIT BANG DRIVER
                                    143 ;=======================================================================
                                    144 
                                    145 
                                    146 ;========================================================================
                                    147 ;						UART INITIALIZATION
                                    148 ;========================================================================
      000113                        149 UART_INIT:
                                    150 			; SW_RX		.EQU		P3.0				; MCU_RxD(P3.0), SW UART RX GPIO pin (must be /INT4)
                                    151 			; SW_TX		.EQU		P3.1				; MCU_TxD(P3.1), SW UART TX GPIO pin (can be any GPIO pin)
                                    152 			; P3M1[7 : 0]	P3M0 [7 : 0]
                                    153 			; 		1			0			P3.0 input-only (high-impedance )
                                    154 			;MOV	P3M1,	#0b00000001			;
                                    155 			;MOV	P3M0,	#0b00000000			;
                                    156 
                                    157 			; Serial Port Control Register
      000113 D2 B1            [12]  158 			SETB	SW_TX					; set TX output MARK
                                    159 			; SWSCON
      000115 C2 00            [12]  160 			CLR	SWRI						; Receive interrupt flag, set on 8th RX BIT in, cleared by software.
      000117 C2 01            [12]  161 			CLR	SWTI	                    ; Transmit interrupt flag, set on 8th TX BIT out, cleared by software.
      000119 C2 02            [12]  162 			CLR	SWBRK	                    ; RX break signal
      00011B C2 03            [12]  163 			CLR	SWBFF	                    ; RX buffer overflow
      00011D C2 04            [12]  164 			CLR	SWREN	                    ; Enables serial reception(1). Transmission (0)
      00011F C2 05            [12]  165 			CLR	SRXBSY	                    ; Receiver Busy. "SWSM0"
      000121 C2 06            [12]  166 			CLR	STXBSY	                    ; Transmitter Busy. "SWSM1"
      000123 C2 07            [12]  167 			CLR	SWFE                        ; Framing Error BIT, should be cleared by software. SM2 on write
                                    168 
                                    169 			;--------------- Configure System Clock Source -------------
                                    170 			; configure system clock source
      000125 53 97 F8         [24]  171 			ANL CLK_DIV,	#(~(CLKS2|CLKS1|CLKS0))			; set system clock divider/1
                                    172 
                                    173 			;------------------ Configure Timer 0 ---------------------- straight from the manual
                                    174 			;ORL		IP,		#PT0			; set timer(0) high priority IRQ
      000128 43 8E 80         [24]  175 			ORL		AUXR,	#0x80			; T0x12, Timer 0 in 1T mode
      00012B 75 89 00         [24]  176 			MOV		TMOD, 	#0x00			; set Timer0 in mode 0(16 bit auto-reloadable mode)
      00012E 53 89 FB         [24]  177 			ANL		TMOD,	#0xFB			; C/T0=0, count on internal system clock
      000131 75 8C F9         [24]  178 			MOV	TH0, #(RXBAUD_HLF >> 8)		; load 1.5 bit time (we assume the start bit is good)
      000134 75 8A 75         [24]  179 			MOV	TL0, #(RXBAUD_HLF & 0xFF)	; Timer0 will interrupt on center of next bit time
      000137 C2 8C            [12]  180 			CLR		TR0						; STOP, Timer/Counter 0 Run Control BIT, (Bit-Addressable)
      000139 C2 A9            [12]  181 			CLR		ET0						; disable Timer0 IRQ
                                    182 
                                    183 			;------------------ Receive Ring Buffer -------------------------
                                    184 			;MOV	RXHEAD,	#RXBUFFER			; received data pointers
                                    185 			;MOV	RXTAIL,	#RXBUFFER
                                    186 			;MOV	RXCNT,	#0x00				; buffer byte count
                                    187 
                                    188 			;------------------ INT4 -----------------------------------
      00013B 53 8F BF         [24]  189 			ANL		AUXR2,	#(~EX4)			; disable interrupts on INT4 port
                                    190 
                                    191 
                                    192 			;------------------ Configure Timer 2 -------------------------
                                    193 			; set-up Timer 2 and INT4
      00013E 53 8E EF         [24]  194 			ANL		AUXR,	#(~T2R)			; Timer2 stop
                                    195 
      000141 75 D6 FB         [24]  196 			MOV		T2H,	#(RXBAUD>>8)	; Data Bits
      000144 75 D7 81         [24]  197 			MOV		T2L,	#(RXBAUD&0xFF)	;
                                    198 
      000147 43 8E 04         [24]  199 			ORL		AUXR,	#T2x12			; T2 in 1T mode, set 1 the clock source of Timer 2 is SYSCLK/1
                                    200 
                                    201 			; Asynchronous Timer2   ; enable the 3 next lines to set timer2 free running with system ticks
                                    202 			;ORL	AUXR,	#T2R				; T2 start to run
                                    203 			;ORL	IE2,	#ET2				; enable T2 interrupt
      00014A 75 35 09         [24]  204 			MOV	SUTXST, #0x09				; in asynchronous Timer2 mode, leave TX State in IDLE, end of transmission
                                    205 
      00014D D2 AF            [12]  206 			SETB	EA						; Go Live!
                                    207 
      00014F 22               [24]  208 			RET
                                    209 
                                    210 
                                    211 ;=======================================================================
                                    212 ; 						OPEN, ALLOW UART RECEPTION
                                    213 ; Allow receive data to be buffered, 16 bytes max, with overflow detection
                                    214 ;=======================================================================
      000150                        215 RX_OPENBUFF:
                                    216 			; set receive state variables
      000150 D2 04            [12]  217 			SETB	SWREN					; RX mode, run
      000152 C2 00            [12]  218 			CLR		SWRI					; no data available
      000154 C2 07            [12]  219 			CLR		SWFE					; clear framing error
      000156 C2 02            [12]  220 			CLR		SWBRK					; clear line break
                                    221 
                                    222 			; enable INT4
      000158 43 8F 40         [24]  223 			ORL	AUXR2,	#EX4				; enable INT4 interrupt, AUXR2
                                    224 			; INT4 is re-enabled at the end of each byte received.
                                    225 
      00015B 22               [24]  226 			RET
                                    227 
                                    228 ;=======================================================================
                                    229 ;				CLOSE, DISABLE UART RECEPTION
                                    230 ;=======================================================================
      00015C                        231 RX_CLOSEBUFF:
                                    232 			; set receive state variables
      00015C C2 04            [12]  233 			CLR		SWREN					; RX mode, run
                                    234 
                                    235 			; disable INT4, halt RX reception
      00015E 53 8F BF         [24]  236 			ANL	AUXR2,	#(~EX4)				; disable INT4 interrupt, AUXR2
                                    237 
      000161 C2 8C            [12]  238 			CLR		TR0						; STOP, Timer/Counter 0 Run Control BIT, (Bit-Addressable)
      000163 C2 A9            [12]  239 			CLR		ET0						; disable Timer0 IRQ
                                    240 
      000165 22               [24]  241 			RET
                                    242 
                                    243 ;=======================================================================
                                    244 ; 						RX SIMPLE RECEIVE
                                    245 ;=======================================================================
      000166                        246 RX_BLIND:	; Receive Blocking
                                    247 
                                    248 			; set receive state variables
      000166 D2 04            [12]  249 			SETB	SWREN					; RX mode
      000168 C2 00            [12]  250 			CLR		SWRI					; no data available
      00016A C2 07            [12]  251 			CLR		SWFE					; clear framing error
      00016C C2 02            [12]  252 			CLR		SWBRK					; clear line break
                                    253 
                                    254 			; enable INT4
      00016E 43 8F 40         [24]  255 			ORL	AUXR2,	#EX4				; enable INT4 interrupt, AUXR2
                                    256 
      000171                        257 RECEIVE_WAIT:								; retrieve data byte
                                    258 			; WAIT, SWRI WILL COMPLETE, if there was a start bit
      000171 30 00 FD         [24]  259 			JNB	SWRI, RECEIVE_WAIT			; no data available
      000174 20 05 FA         [24]  260 			JB	SRXBSY,	RECEIVE_WAIT		; receiver busy
                                    261 
                                    262 			; disable INT4
      000177 53 8F BF         [24]  263 			ANL	AUXR2,	#(~EX4)				; disable INT4 interrupt, AUXR2,
                                    264 
      00017A E5 31            [12]  265 			MOV	A,	RXDATA					; return data
                                    266 
      00017C D3               [12]  267 			SETB	C
      00017D 20 02 04         [24]  268 			JB	SWBRK,	RX_FEBREAK			; indicate error state
      000180 20 07 01         [24]  269 			JB	SWFE,	RX_FEBREAK			; clear flags at application level
      000183 C3               [12]  270 			CLR		C						; no errors
      000184                        271 RX_FEBREAK:
                                    272 
      000184 22               [24]  273 			RET
                                    274 
                                    275 
                                    276 
                                    277 
                                    278 ;=======================================================================
                                    279 ;					UART RECEIVER INTERRUPT SERVICE INT4 & TIMER 0
                                    280 ;=======================================================================
      000185                        281 _INT4_ISR:
      000185 53 8F BF         [24]  282 			ANL     AUXR2,	#(~EX4)			; Disable INT4
      000188 75 34 00         [24]  283 			MOV		SURXST,	#0x00			; start-bit state (0) RECPTION
                                    284 
      00018B                        285 _TIMER0_ISR:
      00018B C0 D0            [24]  286 			PUSH	PSW						; resource preservation
      00018D C0 E0            [24]  287 			PUSH	ACC
      00018F C0 F0            [24]  288 			PUSH	B
      000191 C0 00            [24]  289 			PUSH	0x00					; R0 bank(0)
                                    290 
      000193 C0 83            [24]  291 			PUSH	DPH						; resource preservation
      000195 C0 82            [24]  292 			PUSH	DPL
                                    293 
      000197                        294 SWRX_PROCESS_STATE:
                                    295 
      000197 E5 34            [12]  296 			MOV	A, SURXST					; read state offset from table
      000199 90r01rAB         [24]  297 			MOV	DPTR, #SWRX_STATE_TABLE
      00019C 93               [24]  298 			MOVC	A, @A+DPTR				; 'A' now contains state offset (PC)
      00019D 73               [24]  299 			JMP	@A+DPTR						; execute state
                                    300 
      00019E                        301 TIMER0_ISR_RXEND:							; ALL TX/RX states return here
                                    302 
      00019E D0 82            [24]  303 			POP	DPL							; resource restoration
      0001A0 D0 83            [24]  304 			POP	DPH
                                    305 
      0001A2 D0 00            [24]  306 			POP	0x00						; R0 bank(0)
      0001A4 D0 F0            [24]  307 			POP	B
      0001A6 D0 E0            [24]  308 			POP	ACC							; resource restoration
      0001A8 D0 D0            [24]  309 			POP	PSW
      0001AA 32               [24]  310 			RETI
                                    311 
                                    312 ;-----------------------------------------------------------------------------
                                    313 ; RX STATE MACHINE
                                    314 ;-----------------------------------------------------------------------------
      0001AB                        315 SWRX_STATE_TABLE:							; each table entry is 1 byte
      0001AB 0B                     316 	.DB		SWRX_S0 - SWRX_STATE_TABLE		; idle / start detect
      0001AC 37                     317 	.DB		SWRX_S1 - SWRX_STATE_TABLE		; b0
      0001AD 37                     318 	.DB		SWRX_S2 - SWRX_STATE_TABLE		; b1
      0001AE 37                     319 	.DB		SWRX_S3 - SWRX_STATE_TABLE		; b2
      0001AF 37                     320 	.DB		SWRX_S4 - SWRX_STATE_TABLE		; b3
      0001B0 37                     321 	.DB		SWRX_S5 - SWRX_STATE_TABLE		; b4
      0001B1 37                     322 	.DB		SWRX_S6 - SWRX_STATE_TABLE		; b5
      0001B2 37                     323 	.DB		SWRX_S7 - SWRX_STATE_TABLE		; b6
      0001B3 37                     324 	.DB		SWRX_S8 - SWRX_STATE_TABLE		; b7
      0001B4 42                     325 	.DB		SWRX_S9 - SWRX_STATE_TABLE		; stop bit
      0001B5 AD                     326 	.DB		SWRX_S10 - SWTX_STATE_TABLE		; stop bit terminus/break
                                    327 
                                    328 ;-----------------------------------------------------------------------
                                    329 ;SWRX_S0: RX IDLE state, falling edge has been detected on /INT4.
                                    330 ;-----------------------------------------------------------------------
      0001B6                        331 SWRX_S0:
                                    332 			; START-BIT, INT4 disabled in _INT4_ISR
                                    333 
      0001B6 30 04 1E         [24]  334 			JNB	SWREN, SWRX_S0_END			; (5) Check to see if SW UART RX is enabled, else remain at IDLE state
                                    335 
      0001B9 C2 8C            [12]  336 			CLR	TR0							; (3) Stop TX Timer0 stop, clears any pending interrupt.
      0001BB 43 8E 80         [24]  337 			ORL	AUXR,	#T0x12				; (3) T0x12, set 1 : clock source of Timer 0 is SYSclk/1.
                                    338 
      0001BE 75 8C F9         [24]  339 			MOV	TH0, #(RXBAUD_HLF >> 8)		; (3) load 1.5 bit time (we assume the start bit is good)
      0001C1 75 8A 75         [24]  340 			MOV	TL0, #(RXBAUD_HLF & 0xFF)	; (3) Timer0 will interrupt on center of next bit
                                    341 
      0001C4 D2 8C            [12]  342 			SETB	TR0						; (3) T0 start to run, next access reload_register
                                    343 											; (20) cycles, bit timing correction...
                                    344 
      0001C6 75 8C FB         [24]  345 			MOV	TH0, #(RXBAUD >> 8)			; (3) reload-register 1 bit time (used on next timer 2 reload)
      0001C9 75 8A 81         [24]  346 			MOV	TL0, #(RXBAUD & 0xFF)		; (3)
                                    347 
      0001CC D2 A9            [12]  348 			SETB	ET0						; (3) allow Timer0 to interrupt
      0001CE D2 AF            [12]  349 			SETB	EA						; (3) enable global interrupts
                                    350 
      0001D0 05 34            [12]  351 			INC	SURXST						; (3) next state is SWRX_S1 (we assume START bit was good)
                                    352 
      0001D2 20 B0 04         [24]  353 			JB	SW_RX,	SWRX_S0_ABORT		; (5) false start-bit, reset if start bit went MARK in this state, abort!
                                    354 
      0001D5 D2 05            [12]  355 			SETB	SRXBSY					; good start bit
                                    356 
      0001D7                        357 SWRX_S0_END:
      0001D7r01r9E            [24]  358 			AJMP	TIMER0_ISR_RXEND
                                    359 
      0001D9                        360 SWRX_S0_ABORT:
      0001D9 C2 8C            [12]  361 			CLR	TR0							; Stop TX Timer0 stop
      0001DB C2 A9            [12]  362 			CLR	ET0							; disable Timer0 interrupt
      0001DD 43 8F 40         [24]  363 			ORL		AUXR2,	#EX4			; restart INT4 interrupt
      0001E0r01r9E            [24]  364 			AJMP	TIMER0_ISR_RXEND
                                    365 
                                    366 ;-----------------------------------------------------------------------
                                    367 ;SWRX_S1 through SWRX_S8: capture b0..b7
                                    368 ;-----------------------------------------------------------------------
      0001E2                        369 SWRX_S1:
      0001E2                        370 SWRX_S2:
      0001E2                        371 SWRX_S3:
      0001E2                        372 SWRX_S4:
      0001E2                        373 SWRX_S5:
      0001E2                        374 SWRX_S6:
      0001E2                        375 SWRX_S7:
      0001E2                        376 SWRX_S8:
      0001E2 A2 B0            [12]  377 			MOV	C, SW_RX					; Move RX state into Carry prior to rshift
      0001E4 E5 30            [12]  378 			MOV	A, RXBIN
      0001E6 13               [12]  379 			RRC	A							; right shift Carry into shift register
      0001E7 F5 30            [12]  380 			MOV	RXBIN, A					; re-store
                                    381 
      0001E9 05 34            [12]  382 			INC	SURXST						; advance state variable
                                    383 
      0001EB                        384 SWRX_S2_END:
                                    385 
      0001EBr01r9E            [24]  386 			AJMP	TIMER0_ISR_RXEND
                                    387 
                                    388 ;------------------------------------------------------------------------------------
                                    389 ; STOP BIT, Framing Error  Detection if-then Break Detection
                                    390 ;------------------------------------------------------------------------------------
      0001ED                        391 SWRX_S9:
                                    392 
      0001ED 85 30 31         [24]  393 			MOV	RXDATA, RXBIN				; move received data byte into temp buffer
                                    394 
                                    395 			;; move data to buffer
                                    396 			;MOV	R0,	RXPTR
                                    397 			;MOV	@R0, RXBIN
                                    398 			;INC	RXPTR
                                    399 			;;INC RXCNT						;
                                    400 			;;ANL	RXCNT, #0x0F				; wrap count
                                    401 			;ANL	RXPTR,	#0x4F				; wrap pointer
                                    402 
      0001F0 C2 07            [12]  403 			CLR	SWFE						; cleared by software
      0001F2 20 B0 06         [24]  404 			JB	SW_RX, S9_RXEND				; RX is MARK (1), valid stop
      0001F5 D2 07            [12]  405 			SETB	SWFE					; flag Framing Error
      0001F7 05 34            [12]  406 			INC	SURXST						; test for break command
                                    407 
      0001F9r01r9E            [24]  408 			AJMP	TIMER0_ISR_RXEND		; No stop bit, next state check for break
                                    409 
      0001FB                        410 S9_RXEND:									; good stop bit
                                    411 
      0001FB C2 8C            [12]  412 			CLR	TR0							; Timer0 stop
      0001FD C2 A9            [12]  413 			CLR	ET0							; disable Timer0 to interrupt
                                    414 
                                    415 			; stop bit is in MARK, safe to enable hardware INT4
      0001FF 43 8F 40         [24]  416 			ORL	AUXR2,	#EX4				; enable interrupts on INT4, for next byte
                                    417 			;SETB	EA						; enable global IRQs, already enabled
                                    418 
                                    419 			; ready to receive next byte,
      000202 D2 00            [12]  420 			SETB	SWRI					; set receive flag, data available
      000204 75 34 00         [24]  421 			MOV	SURXST,	#0					; set IDLE state
      000207 C2 05            [12]  422 			CLR	SRXBSY						; Receiver idle
                                    423 
                                    424 
      000209r01r9E            [24]  425 			AJMP	TIMER0_ISR_RXEND
                                    426 
                                    427 ;------------------------------------------------------------------------------------
                                    428 ; RX BREAK, FLAG AND WAIT
                                    429 ;------------------------------------------------------------------------------------
      00020B                        430 SWRX_S10:										; Break Command
                                    431 
      00020B 30 B0 08         [24]  432 			JNB	SW_RX, S10_WAIT					; RX is SPACE, WAIT!
                                    433 
                                    434 			; RX now MARK, evaluate
      00020E E5 30            [12]  435 			MOV	A,	RXBIN
      000210 70 02            [24]  436 			JNZ	S10_SWFE						; data not zero, Frame Error
                                    437 
      000212 D2 02            [12]  438 			SETB	SWBRK						; set flag break
      000214                        439 S10_SWFE:
      000214 80 E5            [24]  440 			SJMP	S9_RXEND					; normal exit, reset for next RX character
                                    441 
      000216                        442 S10_WAIT:
      000216r01r9E            [24]  443 			AJMP	TIMER0_ISR_RXEND			; Repeat S11 state until RX returns to MARK!
                                    444 
                                    445 
                                    446 
                                    447 ;=======================================================================
                                    448 ;  TX UART TRANSMISSION
                                    449 ;=======================================================================
                                    450 ; NOTE: Transmission uses Timer(2) asynchronous clock with NO system ticks
                                    451 
                                    452 ;=======================================================================
                                    453 ; 						TRANSMIT ONE BYTE
                                    454 ;=======================================================================
      000218                        455 TX_TRANSMIT:
                                    456 
      000218 D3               [12]  457 			SETB	C						; set error, cleared if routine runs OK
                                    458 			;JB	SWREN,	TX_TRANSMIT_EXIT	; not in transmit mode
      000219 20 06 22         [24]  459 			JB	STXBSY,	TX_TRANSMIT_EXIT	; TX already busy, can not transmit, IRQ
                                    460 
                                    461 			;ANL	AUXR2,	#(~EX4)				; disable INT4, receiver
                                    462 
      00021C D2 06            [12]  463 			SETB	STXBSY					; indicate TX busy
      00021E C2 01            [12]  464 			CLR	SWTI						; TX data not ready
                                    465 			;CLR	SWREN						; enter transmit mode
                                    466 
      000220 85 33 32         [24]  467 			MOV	TXBIN, TXDATA				; byte into shift register
      000223 75 35 00         [24]  468 			MOV	SUTXST, #0x00				; set TX set to start state
                                    469 
                                    470 			; Asynchronous Timer2 ; set-up timer2 to transmit 1 byte
      000226 53 8E EF         [24]  471 			ANL	AUXR,	#(~T2R)				; T2 stop
      000229 53 AF FB         [24]  472 			ANL	IE2,	#(~ET2)				; disable Timer2 to interrupt
      00022C 43 8E 04         [24]  473 			ORL	AUXR,	#T2x12				; T2 in 1T mode
                                    474 
      00022F 75 D7 81         [24]  475 			MOV	T2L, #(TXBAUD & 0xFF)		; set timer2 reload value
      000232 75 D6 FB         [24]  476 			MOV	T2H, #(TXBAUD >> 8)			;
                                    477 
      000235 43 8E 10         [24]  478 			ORL	AUXR,	#T2R				; T2 start to run
      000238 43 AF 04         [24]  479 			ORL	IE2,	#ET2				; enable T2 interrupt
      00023B D2 AF            [12]  480 			SETB	EA						; enable interrupts
                                    481 
      00023D C3               [12]  482 			CLR	C							; indicate susses
                                    483 
      00023E                        484 TX_TRANSMIT_EXIT:
                                    485 
      00023E 22               [24]  486 			RET
                                    487 
                                    488 ;=======================================================================
                                    489 ;  TIMER 2 INTERRUPT, TX UART TRANSMISSION
                                    490 ;=======================================================================
                                    491 ; NOTE: Not not all configuration have been fully tested
                                    492 
      00023F                        493 _TIMER2_ISR:
      00023F C0 D0            [24]  494 			PUSH	PSW					; resource preservation
      000241 C0 E0            [24]  495 			PUSH	ACC
      000243 C0 F0            [24]  496 			PUSH	B
                                    497 
      000245 C0 83            [24]  498 			PUSH	DPH					; resource preservation
      000247 C0 82            [24]  499 			PUSH	DPL
                                    500 
                                    501 			; JB	SWREN, TIMER2_ISR_TXEND	; NOT Transmit Mode
      000249 30 06 07         [24]  502 			JNB	STXBSY, TIMER2_ISR_TXEND	; no data to send
                                    503 
                                    504 
      00024C E5 35            [12]  505 			MOV	A, SUTXST				; read state offset from table
      00024E 90r02r5E         [24]  506 			MOV	DPTR, #SWTX_STATE_TABLE
      000251 93               [24]  507 			MOVC	A, @A+DPTR			; 'A' now contains state offset (PC)
      000252 73               [24]  508 			JMP	@A+DPTR					; execute state
                                    509 
      000253                        510 TIMER2_ISR_TXEND:						; ALL TX states return here
                                    511 
      000253 D0 82            [24]  512 			POP	DPL						; resource restoration
      000255 D0 83            [24]  513 			POP	DPH
                                    514 
      000257 D0 F0            [24]  515 			POP	B
      000259 D0 E0            [24]  516 			POP	ACC						; resource restoration
      00025B D0 D0            [24]  517 			POP	PSW
                                    518 
      00025D 32               [24]  519 			RETI
                                    520 
                                    521 ;-----------------------------------------------------------------------
                                    522 ; TX STATE TABLE
                                    523 ;-----------------------------------------------------------------------
      00025E                        524 SWTX_STATE_TABLE:						;
      00025E 0A                     525 	.DB		SWTX_S0  - SWTX_STATE_TABLE	; START bit
      00025F 14                     526 	.DB		SWTX_S1  - SWTX_STATE_TABLE	; b0
      000260 14                     527 	.DB		SWTX_S2  - SWTX_STATE_TABLE	; b1
      000261 14                     528 	.DB		SWTX_S3  - SWTX_STATE_TABLE	; b2
      000262 14                     529 	.DB		SWTX_S4  - SWTX_STATE_TABLE	; b3
      000263 14                     530 	.DB		SWTX_S5  - SWTX_STATE_TABLE	; b4
      000264 14                     531 	.DB		SWTX_S6  - SWTX_STATE_TABLE	; b5
      000265 14                     532 	.DB		SWTX_S7  - SWTX_STATE_TABLE	; b6
      000266 14                     533 	.DB		SWTX_S8  - SWTX_STATE_TABLE	; b7
      000267 20                     534 	.DB		SWTX_S9 - SWTX_STATE_TABLE	; stop bit1
                                    535 
                                    536 ;-----------------------------------------------------------------------
                                    537 ;	SWTX_S0: TX START bit state
                                    538 ;-----------------------------------------------------------------------
      000268                        539 SWTX_S0:
                                    540 			; Timer 2 started in Transmit routine
                                    541 
      000268 C2 B1            [12]  542 			CLR	SW_TX						; START bit onset edge
      00026A D2 01            [12]  543 			SETB	SWTI					; TX buffer full
      00026C D2 06            [12]  544 			SETB	STXBSY					; transmission in process
                                    545 
      00026E 05 35            [12]  546 			INC	SUTXST						; next state is SWTX_S1
                                    547 
      000270                        548 SWTX_S0_END:
      000270 80 E1            [24]  549 			SJMP	TIMER2_ISR_TXEND
                                    550 
                                    551 ;-----------------------------------------------------------------------
                                    552 ;	SWTX_S1 thru SWTX_S9: TX b0..b7 and PARITY/STOP bit
                                    553 ;-----------------------------------------------------------------------
      000272                        554 SWTX_S1:									; data bit(0)
      000272                        555 SWTX_S2:
      000272                        556 SWTX_S3:
      000272                        557 SWTX_S4:
      000272                        558 SWTX_S5:
      000272                        559 SWTX_S6:
      000272                        560 SWTX_S7:
      000272                        561 SWTX_S8:									; data bit (7)
                                    562 
      000272 E5 32            [12]  563 			MOV	A, TXBIN					; right shift next bit to transmit into Carry
      000274 D3               [12]  564 			SETB	C						; shift a STOP bit into MSB
      000275 13               [12]  565 			RRC	A
      000276 F5 32            [12]  566 			MOV	TXBIN,	A					; re-store value
      000278 92 B1            [24]  567 			MOV	SW_TX,	C					; output bit on GPIO pin
                                    568 
      00027A 05 35            [12]  569 			INC	SUTXST						; advance to next state
                                    570 
      00027C                        571 SWTX_S1_END:
      00027Cr02r53            [24]  572 			AJMP	TIMER2_ISR_TXEND
                                    573 
                                    574 ;-----------------------------------------------------------------------
                                    575 ;	SWTX_S9 First STOP bit complete / reset to IDLE
                                    576 ;-----------------------------------------------------------------------
      00027E                        577 SWTX_S9:
                                    578 
      00027E D2 B1            [12]  579 			SETB	SW_TX					; output 1st MARK, stop bit
                                    580 
                                    581 			; Asynchronous Timer2 END
      000280 53 8E EF         [24]  582 			ANL	AUXR,	#(~T2R)				; T2 STOP! Stop bit sent.
      000283 53 AF FB         [24]  583 			ANL	IE2,	#(~ET2)				; disable Timer2 to interrupt
                                    584 
                                    585 			; stay in this current state until next TX
      000286 D2 01            [12]  586 			SETB	SWTI					; Set SWTI to indicate transmit complete
      000288 C2 06            [12]  587 			CLR	STXBSY						; Clear STXBSY to indicate transmitter available
                                    588 
      00028A                        589 SWTX_S9_END:
      00028A 80 C7            [24]  590 			SJMP	TIMER2_ISR_TXEND
                                    591 
                                    592 
                                    593 ;-----------------------------------------------------------------------
                                    594 ;						END BIT-BANG UART
                                    595 ;-----------------------------------------------------------------------
                                    596 
                                    597 
                                    598 ;=======================================================================
                                    599 ;					END OF PROGRAM
                                    600 ;=======================================================================
                                    601 
