                                      1 ; ASSEMBLER CODE: INTEL 8051 device STC15W104
                                      2 ; SDCC SDAS8051 ASSEMBLER
                                      3 ; BIT_BANG UART     8 bit data, no-parity, 1 stop bit, 19200 baud, Interrupt Driven
                                      4 ; Timer 0 Data Reception
                                      5 ; Timer 2 Data Transmission
                                      6 
                                      7 .module bb_uart_drv
                                      8 
                                      9 .optsdcc -mmcs51 --model-small -iram-size 128 --xram-size 0 --code-size 4088
                                     10 
                                     11 .include "stc15w-sdcc.inc"			; STC15W104 Processor header file
