                           000002   636 	EPC2H	.equ	0x02	  ; b1 EPC2H	; Associated with CCAP1H, it is used in PCA PWM mode.
                           000001   637 	EPC2L	.equ	0x01	  ; b0 EPC2L	; Associated with CCAP1L, it is used in PCA PWM mode.
                                    638 	
                                    639 ; 0xF5	not used
                                    640 ; 0xF6	not used
                                    641 ; 0xF7	not used
                                    642 
                           0000F8   643 P7 .equ 0xF8                  ; P7,	I/O port 7,	(Bit-Addressable)
                           0000FF   644 	P77 .equ 0xF8+7             
                           0000FE   645 	P76 .equ 0xF8+6             
                           0000FD   646 	P75 .equ 0xF8+5             
                           0000FC   647 	P74 .equ 0xF8+4             
                           0000FB   648 	P73 .equ 0xF8+3             
                           0000FA   649 	P72 .equ 0xF8+2             
                           0000F9   650 	P71 .equ 0xF8+1             
                           0000F8   651 	P70 .equ 0xF8+0             
                                    652 	
                           0000F9   653 CH .equ 0xF9                  ; PCA Counter High Byte
                                    654 
                           0000FA   655 CCAP0H .equ 0xFA              ; PCA Module 0 Capture/Compare Register High Byte
                                    656 
                           0000FB   657 CCAP1H .equ 0xFB              ; PCA Module 1 Capture/Compare Register High Byte
                                    658 
                           0000FC   659 CCAP2H .equ 0xFC              ; PCA Module 2 Capture/Compare Register High Byte
                                    660 
                                    661 ; 0xFD	not used
                                    662 ; 0xFE	not used
                                    663 ; 0xFF	not used
                                    664 
                                    665 
                                    666 
                                     31 
                                     32 ;-----------------------------------------------------------------------
                                     33 ; Software UART
                                     34 ;-----------------------------------------------------------------------
                           1517E70    35 MPU_CLK_HZ	.EQU		22118000			; 22.118MHz, 30.041 MHz Max
                           000001    36 CLKDV		.EQU		1					; system clock No divide
                           00000C    37 CLKDV12		.EQU		12					; system clock divide 12
                                     38 
                           0000B0    39 SW_RX		.EQU		P3.0				; MCU_RxD(P3.0), SW UART RX GPIO pin (must be /INT4)
                           0000B1    40 SW_TX		.EQU		P3.1				; MCU_TxD(P3.1), SW UART TX GPIO pin (can be any GPIO pin)
                           000000    41 RX_PROBE	.EQU		0					; 1: toggle P3.2 at every RX sample instant (scope trim)
                           0000B2    42 PROBE_PIN	.EQU		P3.2
                                     43 ;
                           004B00    44 BAUD		.EQU		19200				; baud rate
                           000480    45 BAUD_RATE	.EQU		(((MPU_CLK_HZ/CLKDV)+(BAUD/2))/BAUD)	; cycles per bit, rounded (1152)
                                     46 ;
                                     47 ; Latency corrections, in system clocks. Values are from the cycle-counted model
                                     48 ; in sim/ (STC15 instruction timings, 6 clock interrupt entry). Trim on hardware
                                     49 ; with RX_PROBE=1: the P3.2 edges must sit in the middle of the RX bit cells.
                           00000D    50 TX_CORR		.EQU		13				; Timer2 overflow -> SW_TX edge, minus TX_TRANSMIT start-bit lead
                           000000    51 RX_CORR		.EQU		0				; per-bit correction (should stay 0)
                           000020    52 THALF_CORR	.EQU		32				; INT4 edge -> Timer0 start + Timer0 overflow -> SW_RX sample
                                     53 ;
                                     54 ; Timer0 is the Receive Clock, started on /INT4 runs asynchronously
                                     55 ; Timer2 is the Transmit Clock, started by TX_TRANSMIT
                                     56 ; Both timers are 16-bit auto-reload: written while stopped, TLx/THx load the counter
                                     57 ; and the reload register; written while running, only the reload register.
                           00FB80    58 TXBAUD		.EQU		(65536-BAUD_RATE)				; TX bit period
                           00FB8D    59 TXBAUD_1ST	.EQU		(65536-(BAUD_RATE-TX_CORR))		; TX start bit period
                           00FB80    60 RXBAUD		.EQU		(65536-(BAUD_RATE-RX_CORR))		; RX bit period
                           00FDE0    61 RXBAUD_HLF	.EQU		(65536-((BAUD_RATE/2)-THALF_CORR))	; edge -> middle of start bit
                                     62 ;
                                     63 ; SWSCON: Software Serial Port Control (Bit-Addressable) Register
                           000020    64 SWSCON		.EQU		0x20				; Serial Port Control Register
                                     65 ; Bits
                           000000    66 SWRI		.EQU		0x00			; Receive flag, set while RX buffer holds data (see RX_POLL)
                           000001    67 SWTI		.EQU		0x01			; Transmit flag, set when the stop bit has been sent, cleared by TX_TRANSMIT
                           000002    68 SWBRK		.EQU		0x02			; RX break signal (sticky, cleared by software)
                           000003    69 SWBFF		.EQU		0x03			; RX buffer overflow, byte dropped (sticky, cleared by software)
                           000004    70 SWREN		.EQU		0x04			; Serial reception enabled (RX_OPENBUFF / RX_CLOSEBUFF)
                           000005    71 SRXBSY		.EQU		0x05			; Receiver Busy. "SWSM0"
                           000006    72 STXBSY		.EQU		0x06			; Transmitter Busy. "SWSM1"
                           000007    73 SWFE		.EQU		0x07			; Framing Error BIT (sticky, cleared by software)
                                     74 ;
                                     75 ; TX shift register, bit-addressable so the ISR can output bit 0 with MOV C,bit
                           000021    76 TXBIN		.EQU		0x21			; TX BIT shift register
                           000008    77 TXBIN0		.EQU		0x08			; bit address of TXBIN.0
                                     78 ;
                                     79 ; UART BYTE BUFFER
                           000030    80 RXBIN		.EQU		0x30			; RX BIT accumulator
                           000031    81 RXDATA		.EQU		0x31			; last byte returned by RX_POLL / RX_BLIND
                           000033    82 TXDATA		.EQU		0x33			; TX Data Buffer
                                     83 ;
                                     84 ; UART STATE MACHINE
                           000034    85 SURXST		.EQU		0x34			; receiver bit counter:   9 start, 8..1 data, 0 stop
                           000035    86 SUTXST		.EQU		0x35			; transmitter bit counter: 10..1
                                     87 ;
                                     88 ; UART RX RING BUFFER
                           000040    89 RXBUFFER	.EQU		0x40			; 0x40 - 0x4F Receive Buffer (16 byte aligned)
                           00004F    90 RXBUFEND	.EQU		(RXBUFFER+0x0F)	; buffer end, also the wrap mask (15 bytes usable)
                           000036    91 RXTAIL		.EQU		0x36			; read pointer, owned by RX_POLL
                           000008    92 RXHEAD		.EQU		0x08			; write pointer = R0 of bank 1, owned by the RX ISR
                                     93 ;
                                     94 
                                     95 ;=======================================================
                                     96 ; Interrupt Vectors Table (ABS addresses 0x0000-0x002B)
                                     97 ;=======================================================
                                     98 .area VECTOR    (CODE)
                                     99 .area INTV (ABS)				; allow .org defines
                                    100 
                                    101 		;; --- Rest Vector  ---
      000000                        102 		.ORG    0x0000
      000000 02r01r00         [24]  103 		LJMP    _START
                                    104 
                                    105 		;; --- Externa 0 Interrupt (INT0) ---
                                    106 		.area INT0 (ABS,CODE)
      000003                        107 		.ORG    0x0003
      000003 32               [24]  108 		RETI
                                    109 
                                    110 		;; --- Timer 0 Interrupt (TF0) ---
                                    111 		.area TMR0 (ABS,CODE)
      00000B                        112 		.ORG    0x000B
      00000B 02r01r9F         [24]  113 		LJMP	_TIMER0_ISR
                                    114 
                                    115 		;; --- Externa 1 Interrupt (INT1) ---
                                    116 		.area INT1 (ABS,CODE)
      000013                        117 		.ORG    0x0013
      000013 32               [24]  118 		RETI
                                    119 
                                    120 		;; --- Externa 2 Interrupt (INT2) ---
                                    121 		.area INT2 (ABS,CODE)
      000053                        122 		.ORG    0x0053
      000053 32               [24]  123 		RETI
                                    124 
                                    125 		;; --- Externa 3 Interrupt (INT3) ---
                                    126 		.area INT3 (ABS,CODE)
      00005B                        127 		.ORG    0x005B
      00005B 32               [24]  128 		RETI
                                    129 
                                    130 		;; --- Timer 2 Interrupt (TF2) ---
                                    131 		.area TMR2 (ABS,CODE)
      000063                        132 		.ORG    0x0063      ; Timer 2
      000063 02r02r0F         [24]  133 		LJMP   _TIMER2_ISR
                                    134 
                                    135 		;; --- Externa 4 Interrupt (INT4) ---
                                    136 		.area INT4 (ABS,CODE)
      000083                        137 		.ORG    0x0083
      000083 02r01r86         [24]  138 		LJMP   _INT4_ISR
                                    139 
                                    140 
                                    141 ; ============================================================
                                    142 ;				MAIN PROGRAM CODE
                                    143 ; ============================================================
                                    144 .AREA CSEG (ABS,CODE) ; ABSOLUTE ADDRESS, debugging
      000100                        145 .ORG 0X0100
                                    146 
      000100                        147 _START:
                                    148 
                                    149 			; INITIALIZE STACK POINTER
      000100 75 81 60         [24]  150 			MOV SP, 	#0x60           ; set stack pointer STACK TEST, 32 byte stack
      000103 53 D0 E7         [24]  151 			ANL	PSW,	#(~0x18)		; Bank zero(0)
                                    152 
      000106r01r14            [24]  153 			ACALL	UART_INIT			; bit-bang uart configuration
      000108r01r40            [24]  154 			ACALL	RX_OPENBUFF			; receiver runs from now on, in the background
                                    155 
      00010A                        156 _START00:
                                    157 
      00010Ar01r7B            [24]  158 			ACALL	RX_BLIND			; call is blocking, A = data
                                    159 
                                    160 			; echo back data
      00010C F5 33            [12]  161 			MOV	TXDATA,	A
      00010E                        162 TX_RETRY:
      00010Er01rEA            [24]  163 			ACALL	TX_TRANSMIT
      000110 40 FC            [24]  164 			JC	TX_RETRY				; transmitter busy with previous byte, retry
                                    165 
      000112 80 F6            [24]  166 			SJMP	_START00
                                    167 
                                    168 
                                    169 
                                    170 ;=======================================================================
                                    171 ;				UART BIT BANG DRIVER
                                    172 ;=======================================================================
                                    173 ; Resources:  Timer0 + INT4 (RX), Timer2 (TX), register bank 1 R0 (RX ISR),
                                    174 ;             IRAM 0x20-0x21, 0x30-0x36, 0x40-0x4F.
                                    175 ; Callers run in register bank 0.
                                    176 
                                    177 
                                    178 ;========================================================================
                                    179 ;						UART INITIALIZATION
                                    180 ;========================================================================
      000114                        181 UART_INIT:
                                    182 			; SW_RX		.EQU		P3.0				; MCU_RxD(P3.0), SW UART RX GPIO pin (must be /INT4)
                                    183 			; SW_TX		.EQU		P3.1				; MCU_TxD(P3.1), SW UART TX GPIO pin (can be any GPIO pin)
                                    184 			; P3M1[7 : 0]	P3M0 [7 : 0]
                                    185 			; 		1			0			P3.0 input-only (high-impedance )
                                    186 			;MOV	P3M1,	#0b00000001			;
                                    187 			;MOV	P3M0,	#0b00000000			;
                                    188 
      000114 D2 B1            [12]  189 			SETB	SW_TX					; set TX output MARK
      000116 75 20 00         [24]  190 			MOV		SWSCON,	#0x00			; all flags clear, RX disabled, TX idle
                                    191 
      000119 75 36 40         [24]  192 			MOV		RXTAIL,	#RXBUFFER		; empty receive ring
      00011C 75 08 40         [24]  193 			MOV		RXHEAD,	#RXBUFFER
                                    194 
                                    195 			;--------------- Configure System Clock Source -------------
      00011F 53 97 F8         [24]  196 			ANL CLK_DIV,	#(~(CLKS2|CLKS1|CLKS0))			; set system clock divider/1
                                    197 
                                    198 			;------------------ INT4 -----------------------------------
      000122 53 8F BF         [24]  199 			ANL		AUXR2,	#(~EX4)			; disabled until RX_OPENBUFF
                                    200 
                                    201 			;------------------ Configure Timer 0 (RX) ------------------
      000125 C2 8C            [12]  202 			CLR		TR0						; STOP
      000127 53 89 F0         [24]  203 			ANL		TMOD,	#0xF0			; Timer0 mode 0 (16 bit auto-reload), timer, no gate
      00012A 43 8E 80         [24]  204 			ORL		AUXR,	#T0x12			; Timer 0 in 1T mode
      00012D C2 8D            [12]  205 			CLR		TF0
      00012F 43 B8 02         [24]  206 			ORL		IP,		#PT0			; high priority: RX sampling preempts TX and INT4
      000132 D2 A9            [12]  207 			SETB	ET0						; only runs while a frame is being received
                                    208 
                                    209 			;------------------ Configure Timer 2 (TX) -------------------
      000134 53 8E EF         [24]  210 			ANL		AUXR,	#(~T2R)			; Timer2 stop
      000137 43 8E 04         [24]  211 			ORL		AUXR,	#T2x12			; T2 in 1T mode, clock source SYSCLK/1
      00013A 43 AF 04         [24]  212 			ORL		IE2,	#ET2			; only runs while a frame is being sent
                                    213 
      00013D D2 AF            [12]  214 			SETB	EA						; Go Live!
                                    215 
      00013F 22               [24]  216 			RET
                                    217 
                                    218 
                                    219 ;=======================================================================
                                    220 ; 						OPEN, ALLOW UART RECEPTION
                                    221 ; Received bytes are buffered, 15 bytes max, with overflow detection (SWBFF)
                                    222 ;=======================================================================
      000140                        223 RX_OPENBUFF:
      000140 C2 07            [12]  224 			CLR		SWFE					; clear framing error
      000142 C2 02            [12]  225 			CLR		SWBRK					; clear line break
      000144 C2 03            [12]  226 			CLR		SWBFF					; clear overflow
      000146 D2 04            [12]  227 			SETB	SWREN					; RX enabled
      000148 43 8F 40         [24]  228 			ORL		AUXR2,	#EX4			; arm start-bit detection
      00014B 22               [24]  229 			RET
                                    230 
                                    231 ;=======================================================================
                                    232 ;				CLOSE, DISABLE UART RECEPTION
                                    233 ; Buffered bytes stay readable with RX_POLL / RX_BLIND.
                                    234 ;=======================================================================
      00014C                        235 RX_CLOSEBUFF:
      00014C 53 8F BF         [24]  236 			ANL		AUXR2,	#(~EX4)			; no new frames
      00014F C2 8C            [12]  237 			CLR		TR0						; abort frame in progress
      000151 C2 05            [12]  238 			CLR		SRXBSY
      000153 C2 04            [12]  239 			CLR		SWREN
      000155 22               [24]  240 			RET
                                    241 
                                    242 ;=======================================================================
                                    243 ; 						RX POLL, NON BLOCKING
                                    244 ; out:	C=1  buffer empty
                                    245 ;		C=0  A = RXDATA = received byte
                                    246 ; uses R0 (restored)
                                    247 ;=======================================================================
      000156                        248 RX_POLL:
      000156 C2 00            [12]  249 			CLR		SWRI					; ISR sets it again for a byte arriving from here on
      000158 E5 36            [12]  250 			MOV		A,	RXTAIL
      00015A B5 08 02         [24]  251 			CJNE	A,	RXHEAD,	RX_POLL1	; tail != head: data available
      00015D D3               [12]  252 			SETB	C
      00015E 22               [24]  253 			RET
      00015F                        254 RX_POLL1:
      00015F C0 00            [24]  255 			PUSH	0x00					; R0 bank(0)
      000161 F8               [12]  256 			MOV		R0,	A					; R0 -> oldest byte
      000162 04               [12]  257 			INC		A
      000163 54 4F            [12]  258 			ANL		A,	#RXBUFEND			; wrap
      000165 C0 E0            [24]  259 			PUSH	ACC						; new tail
      000167 E6               [12]  260 			MOV		A,	@R0					; data
      000168 D0 36            [24]  261 			POP		RXTAIL					; release the slot only after reading it
      00016A F5 31            [12]  262 			MOV		RXDATA,	A
      00016C D0 00            [24]  263 			POP		0x00
                                    264 
      00016E E5 36            [12]  265 			MOV		A,	RXTAIL				; more data left? keep SWRI set
      000170 B5 08 02         [24]  266 			CJNE	A,	RXHEAD,	RX_POLL2
      000173 80 02            [24]  267 			SJMP	RX_POLL3
      000175                        268 RX_POLL2:
      000175 D2 00            [12]  269 			SETB	SWRI
      000177                        270 RX_POLL3:
      000177 E5 31            [12]  271 			MOV		A,	RXDATA
      000179 C3               [12]  272 			CLR		C
      00017A 22               [24]  273 			RET
                                    274 
                                    275 ;=======================================================================
                                    276 ; 						RX SIMPLE RECEIVE, BLOCKING
                                    277 ; out:	A = RXDATA = received byte
                                    278 ;		C = SWFE | SWBRK | SWBFF, error flags are sticky, clear at application level
                                    279 ;=======================================================================
      00017B                        280 RX_BLIND:
      00017Br01r56            [24]  281 			ACALL	RX_POLL
      00017D 40 FC            [24]  282 			JC		RX_BLIND				; wait for data
      00017F A2 07            [12]  283 			MOV		C,	SWFE				; indicate error state
      000181 72 02            [24]  284 			ORL		C,	SWBRK
      000183 72 03            [24]  285 			ORL		C,	SWBFF
      000185 22               [24]  286 			RET
                                    287 
                                    288 
                                    289 ;=======================================================================
                                    290 ;				UART RECEIVER INTERRUPT SERVICE INT4 & TIMER 0
                                    291 ;=======================================================================
                                    292 ; INT4: leading (falling) edge of the start bit. Starts Timer0 so that its first
                                    293 ; overflow falls in the middle of the start bit, every following one a bit time
                                    294 ; later. No registers or flags are touched, so nothing needs saving.
      000186                        295 _INT4_ISR:
      000186 75 8A E0         [24]  296 			MOV		TL0,	#(RXBAUD_HLF & 0xFF)	; (3) Timer0 stopped: counter and reload
      000189 75 8C FD         [24]  297 			MOV		TH0,	#(RXBAUD_HLF >> 8)		; (3)
      00018C D2 8C            [12]  298 			SETB	TR0								; (3) running, first overflow at mid start bit
      00018E 75 8A 80         [24]  299 			MOV		TL0,	#(RXBAUD & 0xFF)		; running: reload register only,
      000191 75 8C FB         [24]  300 			MOV		TH0,	#(RXBAUD >> 8)			; 1 bit time for the following overflows
      000194 C2 8D            [12]  301 			CLR		TF0
      000196 53 8F BF         [24]  302 			ANL		AUXR2,	#(~EX4)			; ignore data edges until the stop bit
      000199 75 34 09         [24]  303 			MOV		SURXST,	#9				; next Timer0 overflow: start bit check
      00019C D2 05            [12]  304 			SETB	SRXBSY
      00019E 32               [24]  305 			RETI
                                    306 
                                    307 ;-----------------------------------------------------------------------------
                                    308 ; Timer0: one interrupt per bit cell, SURXST counts down
                                    309 ;	9     middle of start bit, abort if the line is MARK again (glitch)
                                    310 ;	8..1  data b0..b7
                                    311 ;	0     stop bit, deliver byte
                                    312 ;-----------------------------------------------------------------------------
      00019F                        313 _TIMER0_ISR:
      00019F C0 D0            [24]  314 			PUSH	PSW						; (3)
      0001A1 A2 B0            [12]  315 			MOV		C,	SW_RX				; (2) sample RX, fixed delay after the overflow
                           000000   316 		.if RX_PROBE
                                    317 			CPL		PROBE_PIN				; scope: marks the sampling instant
                                    318 		.endif
      0001A3 C0 E0            [24]  319 			PUSH	ACC
                                    320 
      0001A5 E5 34            [12]  321 			MOV		A,	SURXST
      0001A7 60 1B            [24]  322 			JZ		SWRX_STOP				; stop bit
      0001A9 15 34            [12]  323 			DEC		SURXST
      0001AB 64 09            [12]  324 			XRL		A,	#9					; XRL/JZ leave the sample in C untouched
      0001AD 60 0A            [24]  325 			JZ		SWRX_START				; start bit
                                    326 
      0001AF E5 30            [12]  327 			MOV		A,	RXBIN				; data bit: right shift Carry into shift register
      0001B1 13               [12]  328 			RRC		A
      0001B2 F5 30            [12]  329 			MOV		RXBIN,	A
                                    330 
      0001B4                        331 TIMER0_ISR_RXEND:
      0001B4 D0 E0            [24]  332 			POP		ACC
      0001B6 D0 D0            [24]  333 			POP		PSW
      0001B8 32               [24]  334 			RETI
                                    335 
      0001B9                        336 SWRX_START:
      0001B9 50 F9            [24]  337 			JNC		TIMER0_ISR_RXEND		; still SPACE: good start bit
      0001BB C2 8C            [12]  338 			CLR		TR0						; false start (noise), back to idle
      0001BD C2 05            [12]  339 			CLR		SRXBSY
      0001BF 43 8F 40         [24]  340 			ORL		AUXR2,	#EX4
      0001C2 80 F0            [24]  341 			SJMP	TIMER0_ISR_RXEND
                                    342 
                                    343 ;------------------------------------------------------------------------------------
                                    344 ; STOP BIT, Framing Error  Detection if-then Break Detection
                                    345 ;------------------------------------------------------------------------------------
      0001C4                        346 SWRX_STOP:
      0001C4 C2 8C            [12]  347 			CLR		TR0						; frame complete, Timer0 stop
      0001C6 43 8F 40         [24]  348 			ORL		AUXR2,	#EX4			; re-arm start-bit detection (mid stop bit). If the
                                    349 											; line is still SPACE (error/BREAK) the next falling
                                    350 											; edge only comes after it returned to MARK
      0001C9 C2 05            [12]  351 			CLR		SRXBSY
      0001CB 40 08            [24]  352 			JC		SWRX_PUT				; stop bit is MARK, valid frame
      0001CD D2 07            [12]  353 			SETB	SWFE					; flag Framing Error
      0001CF E5 30            [12]  354 			MOV		A,	RXBIN
      0001D1 70 02            [24]  355 			JNZ		SWRX_PUT
      0001D3 D2 02            [12]  356 			SETB	SWBRK					; all zero + no stop bit: BREAK
      0001D5                        357 SWRX_PUT:
      0001D5 75 D0 08         [24]  358 			MOV		PSW,	#0x08			; bank 1, R0 = RXHEAD (PSW restored on exit)
      0001D8 E8               [12]  359 			MOV		A,	R0
      0001D9 04               [12]  360 			INC		A
      0001DA 54 4F            [12]  361 			ANL		A,	#RXBUFEND			; wrap
      0001DC B5 36 04         [24]  362 			CJNE	A,	RXTAIL,	SWRX_PUT1	; next head == tail: buffer full
      0001DF D2 03            [12]  363 			SETB	SWBFF					; overflow, byte dropped
      0001E1 80 D1            [24]  364 			SJMP	TIMER0_ISR_RXEND
      0001E3                        365 SWRX_PUT1:
      0001E3 A6 30            [24]  366 			MOV		@R0,	RXBIN			; store byte
      0001E5 F8               [12]  367 			MOV		R0,	A					; then publish it
      0001E6 D2 00            [12]  368 			SETB	SWRI					; data available
      0001E8 80 CA            [24]  369 			SJMP	TIMER0_ISR_RXEND
                                    370 
                                    371 
                                    372 ;=======================================================================
                                    373 ;  TX UART TRANSMISSION
                                    374 ;=======================================================================
                                    375 
                                    376 ;=======================================================================
                                    377 ; 						TRANSMIT ONE BYTE
                                    378 ; in:	TXDATA
                                    379 ; out:	C=1 transmitter busy, nothing done (retry)
                                    380 ;		C=0 transmission started, STXBSY set until the stop bit is complete
                                    381 ;=======================================================================
      0001EA                        382 TX_TRANSMIT:
                                    383 
      0001EA D3               [12]  384 			SETB	C						; set error, cleared if routine runs OK
      0001EB 20 06 20         [24]  385 			JB		STXBSY,	TX_TRANSMIT_EXIT	; TX already busy, can not transmit
                                    386 
      0001EE D2 06            [12]  387 			SETB	STXBSY					; indicate TX busy
      0001F0 C2 01            [12]  388 			CLR		SWTI					; transmission not complete
      0001F2 85 33 21         [24]  389 			MOV		TXBIN,	TXDATA			; byte into shift register
      0001F5 75 35 0A         [24]  390 			MOV		SUTXST,	#10				; 8 data + stop + end of stop
                                    391 
      0001F8 75 D7 8D         [24]  392 			MOV		T2L,	#(TXBAUD_1ST & 0xFF)	; Timer2 stopped: counter and reload
      0001FB 75 D6 FB         [24]  393 			MOV		T2H,	#(TXBAUD_1ST >> 8)		; start bit period
                                    394 
      0001FE C2 AF            [12]  395 			CLR		EA						; keep timer start and start bit edge together
      000200 43 8E 10         [24]  396 			ORL		AUXR,	#T2R			; T2 start to run
      000203 C2 B1            [12]  397 			CLR		SW_TX					; START bit
      000205 D2 AF            [12]  398 			SETB	EA
                                    399 
      000207 75 D7 80         [24]  400 			MOV		T2L,	#(TXBAUD & 0xFF)		; running: reload register only
      00020A 75 D6 FB         [24]  401 			MOV		T2H,	#(TXBAUD >> 8)			; data/stop bit period
                                    402 
      00020D C3               [12]  403 			CLR		C						; indicate success
                                    404 
      00020E                        405 TX_TRANSMIT_EXIT:
                                    406 
      00020E 22               [24]  407 			RET
                                    408 
                                    409 ;=======================================================================
                                    410 ;  TIMER 2 INTERRUPT, TX UART TRANSMISSION
                                    411 ;=======================================================================
                                    412 ; SUTXST 10..3  output b0..b7
                                    413 ;        2      output stop bit (MARK was shifted in behind the data)
                                    414 ;        1      end of stop bit: stop Timer2, transmitter free
      00020F                        415 _TIMER2_ISR:
      00020F C0 D0            [24]  416 			PUSH	PSW						; (3)
      000211 A2 08            [12]  417 			MOV		C,	TXBIN0				; (2) bit for this cell was prepared last time
      000213 92 B1            [24]  418 			MOV		SW_TX,	C				; (3) output bit on GPIO pin, fixed delay
      000215 C0 E0            [24]  419 			PUSH	ACC
                                    420 
      000217 E5 21            [12]  421 			MOV		A,	TXBIN				; prepare next bit
      000219 D3               [12]  422 			SETB	C						; shift a STOP bit into MSB
      00021A 13               [12]  423 			RRC		A
      00021B F5 21            [12]  424 			MOV		TXBIN,	A
                                    425 
      00021D D5 35 07         [24]  426 			DJNZ	SUTXST,	TIMER2_ISR_TXEND
                                    427 
      000220 53 8E EF         [24]  428 			ANL		AUXR,	#(~T2R)			; T2 STOP! Stop bit sent.
      000223 C2 06            [12]  429 			CLR		STXBSY					; transmitter available
      000225 D2 01            [12]  430 			SETB	SWTI					; transmit complete
                                    431 
      000227                        432 TIMER2_ISR_TXEND:
      000227 D0 E0            [24]  433 			POP		ACC
      000229 D0 D0            [24]  434 			POP		PSW
      00022B 32               [24]  435 			RETI
                                    436 
                                    437 
                                    438 ;-----------------------------------------------------------------------
                                    439 ;						END BIT-BANG UART
                                    440 ;-----------------------------------------------------------------------
                                    441 
                                    442 
                                    443 ;=======================================================================
                                    444 ;					END OF PROGRAM
                                    445 ;=======================================================================
                                    446 
