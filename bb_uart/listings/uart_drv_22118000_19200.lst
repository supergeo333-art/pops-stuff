                                      1 ; ASSEMBLER CODE: INTEL 8051 device STC15W104
                                      2 ; SDCC SDAS8051 ASSEMBLER
                                      3 ; BIT_BANG UART     8 bit data, no-parity, 1 stop bit, 19200 baud, Interrupt Driven, full duplex
                                      4 ; INT4   Start-bit edge detect (P3.0)
                                      5 ; Timer 0 Data Reception   (high priority)
                                      6 ; Timer 2 Data Transmission
                                      7 ;
                                      8 ; Optimized / verified revision. Changes against the original driver:
                                      9 ;  - FIX: RX state table entry SWRX_S10 used SWTX_STATE_TABLE as base, a framing
                                     10 ;    error or BREAK jumped into the middle of the Timer2 ISR (crash).
                                     11 ;  - RX and TX are fully independent: INT4 stays armed while TX runs, so
                                     12 ;    back-to-back frames are never lost (RX_OPENBUFF once, then RX_BLIND/RX_POLL).
                                     13 ;  - 16 byte RX ring buffer (RXBUFFER) with overflow flag SWBFF.
                                     14 ;  - Start bit is validated at mid-bit (hardware-UART style noise rejection).
                                     15 ;  - Framing error / BREAK handled at the stop-bit sample, no extra polling state:
                                     16 ;    INT4 is falling-edge, so re-arming it with the line held low is harmless.
                                     17 ;  - Jump tables replaced by a down counter: shorter ISRs, no DPTR/B/R0 saves.
                                     18 ;  - Line is sampled (RX) / driven (TX) as the first instruction after PUSH PSW,
                                     19 ;    so the timing is fixed and independent of the state being processed.
                                     20 ;  - TX: start bit is driven by TX_TRANSMIT itself (no idle bit time before the
                                     21 ;    frame) and STXBSY is released only after the full stop bit: 10 bit times per
                                     22 ;    byte, back-to-back.
                                     23 ;  - SWTI now means "transmission complete" (it was also set at the start bit).
                                     24 ;  - Baud divisor is rounded instead of truncated.
                                     25 
                                     26 .module bb_uart_drv
                                     27 
                                     28 .optsdcc -mmcs51 --model-small -iram-size 128 --xram-size 0 --code-size 4088
                                     29 
                                     30 .include "stc15w-sdcc.inc"			; STC15W104 Processor header file
                                      1 ; STC15W series
                                      2 ; Special Function Registers
                                      3 ; Special Function Register Map and Defines
                                      4 ;
                                      5 ; Verification Date: 2026-08-12 - reviewed for errors, matches documentation 
                                      6 ; STC15W408AS-STC15F2K60S2-en.pdf Update Date: 2015/10/10
                                      7 
                                      8 
