                                    117 	; Configure I/O ports mode
                                    118 	; [P1M1.b, P1M0.b]:{0,0} Quasi_bidirectional,Sink Current up to 20mA, 	
                                    119 	;				   {0,1} Push-pull output, 20mA
                                    120 	;				   {1,0} Input-only (high-impedance )
                                    121 	;				   {1,1} Open Drain, no internal pull-up resister
                                    122 	; Example: MOV P1M1, #10100000B
                                    123 	;          MOV P1M0, #11000000B
                                    124 	; P1.7 in Open Drain mode, P1.6 in strong push-pull output, P1.5 in high-impedance input, P1.4-0 quasi_bidirectional
                                    125 	
